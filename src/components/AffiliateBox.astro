---
import { monetization } from '../config/site';
import { DEFAULT_LOCALE, type Locale } from '../config/i18n';

export interface AffiliateItem {
  title: string;
  url: string;
  note?: string;
  price?: string;
}

interface Props {
  items: AffiliateItem[];
  locale?: Locale;
  heading?: string;
}

const HEADINGS: Record<Locale, string> = {
  sr: 'Hardver iz ovog teksta',
  en: 'Hardware from this article',
};

const { items, locale = DEFAULT_LOCALE, heading = HEADINGS[locale] } =
  Astro.props;
const disclosure = monetization.affiliate.disclosure[locale];
---

{
  items.length > 0 && (
    <aside class="affiliate" id="hardver">
      <h2 class="affiliate__heading">{heading}</h2>
      <ul class="affiliate__list">
        {items.map((item) => (
          <li class="affiliate__item">
            <a
              href={item.url}
              class="affiliate__link"
              rel="sponsored nofollow noopener"
              target="_blank"
            >
              {item.title}
            </a>
            {item.price && <span class="affiliate__price">{item.price}</span>}
            {item.note && <p class="affiliate__note">{item.note}</p>}
          </li>
        ))}
      </ul>
      <p class="affiliate__disclosure">{disclosure}</p>
    </aside>
  )
}
