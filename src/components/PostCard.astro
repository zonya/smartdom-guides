---
import { DEFAULT_LOCALE, localeMeta, localePath, ui, type Locale } from '../config/i18n';

interface Props {
  href: string;
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: number;
  /**
   * Sličica kartice. Ovde ide generisana OG slika (`/og/card/<slug>.webp`), ne
   * naslovna slika teksta: screenshot smanjen na širinu kartice je nečitljiv, a
   * u tamnoj temi svetli kao bela ploča. Vidi `src/pages/og/card/`.
   */
  image?: string;
  /** Jezik kartice — od njega zavise format datuma i adrese tema. */
  locale?: Locale;
}

const {
  href,
  title,
  description,
  pubDate,
  tags = [],
  readingTime,
  image,
  locale = DEFAULT_LOCALE,
} = Astro.props;
const t = ui[locale];
const dateLocale = localeMeta[locale].dateLocale;
---

<article class="card">
  {
    image && (
      <a href={href} class="card__thumb" tabindex="-1" aria-hidden="true">
        {/* Slika samo ponavlja naslov koji je odmah ispod, pa je za čitače
            ekrana nema — otuda prazan alt i aria-hidden na linku. */}
        <img src={image} alt="" width="600" height="315" loading="lazy" decoding="async" />
      </a>
    )
  }
  <div class="card__body">
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    <p class="card__meta">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString(dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })}
      </time>
      {readingTime && <span class="card__dot">·</span>}
      {readingTime && <span>{readingTime} {t.minRead}</span>}
    </p>
    {description && <p class="card__desc">{description}</p>}
    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((tag) => (
            <a class="tag" href={localePath(locale, `/tag/${tag}/`)}>
              {tag}
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>
