---
import '../styles/global.css';
import { site, monetization, analytics } from '../config/site';
import { LOGO_PATHS, LOGO_STROKE } from '../config/logo';
import {
  DEFAULT_LOCALE,
  localeMeta,
  navFor,
  otherLocale,
  pagePath,
  ui,
  type Locale,
} from '../config/i18n';

interface Props {
  title: string;
  description: string;
  /** Ako je true, u <title> se ne dodaje ime sajta (za naslovnu). */
  bareTitle?: boolean;
  /**
   * Putanja do slike za deljenje. Tekstovi šalju svoju (`/og/<slug>.png`),
   * ostatak sajta pada na zajedničku. Slike pravi `src/pages/og/[...slug].png.ts`.
   */
  ogImage?: string;
  /** `article` za pojedinačan tekst, inače `website`. */
  ogType?: 'website' | 'article';
  /** Za radne stranice koje ne treba da završe u pretrazi. */
  noindex?: boolean;
  /**
   * Šira kolona za stranice sa mrežom kartica. Tekstovi ostaju uski — 44rem je
   * širina na kojoj se udobno čita, a to je za spisak kartica pretesno.
   */
  wide?: boolean;
  /** Jezik stranice. Podrazumevano srpski — postojeće stranice ne diraju ovo. */
  lang?: Locale;
  /**
   * Adresa iste stranice na drugom jeziku, ako postoji. Kad je ima, u <head>
   * idu `hreflang` oznake i dugme za jezik vodi tačno na taj prevod; kad je
   * nema, dugme vodi na koren drugog jezika, a `hreflang` se NE emituje —
   * lažna veza između nepovezanih stranica je gore od nikakve.
   */
  altHref?: string;
  /**
   * Stranica ima stubac u margini (`PostRail`). Na širokim ekranima kolona se
   * proširi i podeli na tekst + marginu; ispod praga ostaje kao i pre.
   */
  rail?: boolean;
}

const {
  title,
  description,
  bareTitle = false,
  ogImage = '/og/default.png',
  ogType = 'website',
  noindex = false,
  wide = false,
  lang = DEFAULT_LOCALE,
  altHref,
  rail = false,
} = Astro.props;
const meta = localeMeta[lang];
const t = ui[lang];
const other = otherLocale(lang);
const otherMeta = localeMeta[other];
const nav = navFor(lang);
const langHref = altHref ?? otherMeta.home;
const alternates = altHref
  ? [
      { hreflang: meta.htmlLang, href: new URL(Astro.url.pathname, site.url).href },
      { hreflang: otherMeta.htmlLang, href: new URL(altHref, site.url).href },
      {
        hreflang: 'x-default',
        href: new URL(
          lang === DEFAULT_LOCALE ? Astro.url.pathname : altHref,
          site.url
        ).href,
      },
    ]
  : [];
const pageTitle = bareTitle ? title : `${title} · ${site.name}`;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

// Ime se u zaglavlju piše u dva dela — domen se boji akcentom, pa se „opameti"
// i „.me" vide kao ime i nastavak, a ne kao jedna adresa.
const dot = site.name.lastIndexOf('.');
const nameStem = dot > 0 ? site.name.slice(0, dot) : site.name;
const nameTld = dot > 0 ? site.name.slice(dot) : '';
const adsLive = monetization.ads.enabled && monetization.ads.client;
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={lang === DEFAULT_LOCALE ? '/rss.xml' : '/en/rss.xml'}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Tema se postavlja pre iscrtavanja da ne bi bljesnula pogrešna boja. -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') {
        document.documentElement.dataset.theme = saved;
      }
    </script>

    {
      adsLive && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${monetization.ads.client}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href={meta.home} class="logo">
          <svg
            viewBox="0 0 32 32"
            fill="none"
            stroke="currentColor"
            stroke-width={LOGO_STROKE}
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={LOGO_PATHS.roof}></path>
            <path d={LOGO_PATHS.chevron}></path>
            <path d={LOGO_PATHS.underscore}></path>
          </svg>
          <span>{nameStem}<span class="logo__tld">{nameTld}</span></span>
        </a>
        <nav class="site-nav">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            class="lang-toggle"
            href={langHref}
            hreflang={otherMeta.htmlLang}
            lang={otherMeta.htmlLang}
            aria-label={t.langToggle(t.otherLangName)}
            title={t.langToggle(t.otherLangName)}
          >
            {otherMeta.short}
          </a>
          <button
            class="theme-toggle"
            type="button"
            aria-label={t.themeToggle}
            data-theme-toggle
          >
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class:list={['wrap', { 'wrap--wide': wide, 'wrap--rail': rail }]}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>
          &copy; {new Date().getFullYear()} {site.name}
          <span aria-hidden="true"> · </span>
          <span>
            {t.builtBy}{' '}
            {
              site.company.url ? (
                <a href={site.company.url} rel="noopener">{site.company.name}</a>
              ) : (
                <strong>{site.company.name}</strong>
              )
            }
          </span>
        </p>
        <p>
          {
            nav.map((item) => (
              <>
                <a href={item.href}>{item.label}</a>
                <span aria-hidden="true"> · </span>
              </>
            ))
          }
          <a href={pagePath('privacy', lang)}>{t.privacy}</a>
          <span aria-hidden="true"> · </span>
          <a href={lang === DEFAULT_LOCALE ? '/rss.xml' : '/en/rss.xml'}>RSS</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme || (systemDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>

    {
      analytics.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken })}
        />
      )
    }

    {
      adsLive && (
        <script is:inline>
          document.querySelectorAll('ins.adsbygoogle').forEach(() => {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          });
        </script>
      )
    }
  </body>
</html>
