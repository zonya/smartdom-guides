---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { site } from '../config/site';
import { getSortedPosts, readingTime } from '../utils/posts';

const posts = (await getSortedPosts()).slice(0, 5);
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  bareTitle
  wide
>
  <section class="hero">
    <span class="hero__eyebrow">Home Assistant · Linux</span>
    <h1>Automatizacija doma za svakoga</h1>
    <p>
      Vodiči pisani za ljude koji tek počinju — bez žargona, korak po korak,
      sa konkretnim primerima i preporukama hardvera koji se stvarno isplati.
    </p>
    <p>
      <a class="btn" href="/blog/instalacija-home-assistant-30-minuta/">
        Počni odavde
      </a>
      <a class="btn btn--ghost" href="/blog">Svi vodiči</a>
    </p>
  </section>

  <section>
    <div class="section-title">
      <h2>Najnoviji tekstovi</h2>
      <a href="/blog">Svi vodiči →</a>
    </div>
    <div class="card-grid">
      {
        posts.map((post) => (
          <PostCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            readingTime={readingTime(post.body)}
            image={`/og/card/${post.id}.webp`}
          />
        ))
      }
    </div>
  </section>

  <AdSlot slot="list" />
</BaseLayout>
