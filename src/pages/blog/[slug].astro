---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateBox from '../../components/AffiliateBox.astro';
import { site } from '../../config/site';
import {
  findTranslation,
  getSortedPosts,
  postPath,
  readingTime,
} from '../../utils/posts';
import { render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return Promise.all(
    posts.map(async (post, i) => ({
      params: { slug: post.id },
      props: {
        post,
        // lista je sortirana najnoviji-prvi, pa je "noviji" prethodni element
        newer: posts[i - 1] ?? null,
        older: posts[i + 1] ?? null,
        translation: await findTranslation(post),
      },
    }))
  );
}

const { post, newer, older, translation } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);
const affiliate = post.data.affiliate ?? [];
const cover = post.data.cover;
// Slika za deljenje se generiše iz naslova (src/pages/og/[...slug].png.ts).
const ogImage = `/og/${post.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'sr-RS',
  image: new URL(ogImage, site.url).href,
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, site.url).href,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  altHref={translation ? postPath(translation) : undefined}
>
  <article>
    <header class="post__header">
      <h1>{post.data.title}</h1>
      <p class="post__meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {
            post.data.pubDate.toLocaleDateString('sr-Latn-RS', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
          }
        </time>
        <span class="card__dot">·</span>
        <span>{minutes} min čitanja</span>
      </p>
      <p class="post__lead">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <p class="tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`/tag/${tag}/`}>
                {tag}
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      cover ? (
        <figure class="post__cover">
          <Image
            src={cover}
            alt={post.data.coverAlt ?? ''}
            widths={[640, 960, 1280]}
            sizes="(min-width: 46rem) 44rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
          {post.data.coverAlt && <figcaption>{post.data.coverAlt}</figcaption>}
        </figure>
      ) : (
        /* Bez svoje slike tekst je počinjao golim naslovom, a svaka kartica na
           naslovnoj ima pločicu — otuda ista pločica i ovde. Čisto ukras: nosi
           samo temu i znak sajta, pa je za čitače ekrana nema. */
        <figure class="post__cover" aria-hidden="true">
          <img
            src={`/og/head/${post.id}.webp`}
            alt=""
            width="1000"
            height="525"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <AdSlot slot="inArticle" />

    <div class="prose">
      <Content />
    </div>

    <AffiliateBox items={affiliate} />

    <AdSlot slot="belowArticle" />
  </article>

  {
    (newer || older) && (
      <nav class="post-nav" aria-label="Ostali tekstovi">
        {older && (
          <a href={`/blog/${older.id}/`} class="is-prev">
            <span>← Prethodni tekst</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a href={`/blog/${newer.id}/`} class="is-next">
            <span>Sledeći tekst →</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</BaseLayout>
