---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getSortedPosts, readingTime } from '../../utils/posts';

const posts = await getSortedPosts();
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  title="Svi vodiči"
  description="Svi vodiči za Home Assistant i Linux na jednom mestu."
>
  <h1>Svi vodiči</h1>
  <p class="post__lead">
    {posts.length} tekstova, najnoviji prvi.
  </p>

  {
    allTags.length > 0 && (
      <p class="tags">
        {allTags.map((tag) => (
          <a class="tag" href={`/tag/${tag}/`}>
            {tag}
          </a>
        ))}
      </p>
    )
  }

  <div class="card-grid" style="margin-top:2rem">
    {
      posts.map((post) => (
        <PostCard
          href={`/blog/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          readingTime={readingTime(post.body)}
          cover={post.data.cover}
          coverAlt={post.data.coverAlt}
        />
      ))
    }
  </div>

  <AdSlot slot="list" />
</BaseLayout>
