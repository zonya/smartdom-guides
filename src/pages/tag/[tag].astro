---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getSortedPosts, readingTime } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout
  title={`Tema: ${tag}`}
  description={`Svi vodiči na temu „${tag}".`}
>
  <h1>Tema: {tag}</h1>
  <p class="post__lead">{posts.length} tekstova.</p>

  <div class="card-grid" style="margin-top:2rem">
    {
      posts.map((post) => (
        <PostCard
          href={`/blog/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          readingTime={readingTime(post.body)}
          cover={post.data.cover}
          coverAlt={post.data.coverAlt}
        />
      ))
    }
  </div>

  <p style="margin-top:2rem"><a href="/blog">← Svi vodiči</a></p>

  <AdSlot slot="list" />
</BaseLayout>
