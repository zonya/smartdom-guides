---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import AffiliateBox from '../../../components/AffiliateBox.astro';
import AffiliateNotice from '../../../components/AffiliateNotice.astro';
import PostRail from '../../../components/PostRail.astro';
import { site } from '../../../config/site';
import { localeMeta, localePath, ui } from '../../../config/i18n';
import {
  findTranslation,
  getSortedPosts,
  postPath,
  readingTime,
} from '../../../utils/posts';
import { render } from 'astro:content';
import { Image } from 'astro:assets';

const LOCALE = 'en' as const;

export async function getStaticPaths() {
  const posts = await getSortedPosts('en');
  return Promise.all(
    posts.map(async (post, i) => ({
      params: { slug: post.id },
      props: {
        post,
        newer: posts[i - 1] ?? null,
        older: posts[i + 1] ?? null,
        translation: await findTranslation(post),
      },
    }))
  );
}

const { post, newer, older, translation } = Astro.props;
const { Content, headings } = await render(post);
const t = ui[LOCALE];
const minutes = readingTime(post.body);
const affiliate = post.data.affiliate ?? [];
// Obaveštenje ide i kad linkovi postoje samo u prozi, bez boksa na dnu.
const hasAffiliate =
  affiliate.length > 0 || post.body.includes('s.click.aliexpress.com');
const cover = post.data.cover;
const ogImage = `/og/${post.id}.png`;
const here = localePath(LOCALE, `/blog/${post.id}/`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'en',
  image: new URL(ogImage, site.url).href,
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(here, site.url).href,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  rail
  lang={LOCALE}
  altHref={translation ? postPath(translation) : undefined}
>
  <div class="post-col">
  <article>
    <header class="post__header">
      <h1>{post.data.title}</h1>
      <p class="post__meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {
            post.data.pubDate.toLocaleDateString(localeMeta[LOCALE].dateLocale, {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
          }
        </time>
        <span class="card__dot">·</span>
        <span>{minutes} {t.minRead}</span>
      </p>
      <p class="post__lead">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <p class="tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={localePath(LOCALE, `/tag/${tag}/`)}>
                {tag}
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      cover ? (
        <figure class="post__cover">
          <Image
            src={cover}
            alt={post.data.coverAlt ?? ''}
            widths={[640, 960, 1280]}
            sizes="(min-width: 46rem) 44rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
          {post.data.coverAlt && <figcaption>{post.data.coverAlt}</figcaption>}
        </figure>
      ) : (
        /* Bez svoje slike tekst je počinjao golim naslovom, a svaka kartica na
           naslovnoj ima pločicu — otuda ista pločica i ovde. Čisto ukras: nosi
           samo temu i znak sajta, pa je za čitače ekrana nema. */
        <figure class="post__cover" aria-hidden="true">
          <img
            src={`/og/head/${post.id}.webp`}
            alt=""
            width="1000"
            height="525"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <AffiliateNotice show={hasAffiliate} locale={'en'} />

    <AdSlot slot="inArticle" />

    <div class="prose">
      <Content />
    </div>

    <AffiliateBox items={affiliate} locale={LOCALE} />

    <AdSlot slot="belowArticle" />
  </article>

  {
    (newer || older) && (
      <nav class="post-nav" aria-label={t.otherPosts}>
        {older && (
          <a href={localePath(LOCALE, `/blog/${older.id}/`)} class="is-prev">
            <span>{t.prevPost}</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a href={localePath(LOCALE, `/blog/${newer.id}/`)} class="is-next">
            <span>{t.nextPost}</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }
  </div>

  <PostRail headings={headings} affiliate={affiliate} locale={'en'} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</BaseLayout>
