---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { localePath, ui } from '../../../config/i18n';
import { getSortedPosts, readingTime } from '../../../utils/posts';

const LOCALE = 'en' as const;
const t = ui[LOCALE];
const posts = await getSortedPosts(LOCALE);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  title={t.allGuides}
  description="Notes and documentation for the open-source tools and Home Assistant integrations built here."
  lang={LOCALE}
  altHref="/blog/"
  wide
>
  <h1>{t.allGuides}</h1>
  <p class="post__lead">{t.postsCount(posts.length)}</p>

  {
    allTags.length > 0 && (
      <p class="tags">
        {allTags.map((tag) => (
          <a class="tag" href={localePath(LOCALE, `/tag/${tag}/`)}>
            {tag}
          </a>
        ))}
      </p>
    )
  }

  <div class="card-grid" style="margin-top:2rem">
    {
      posts.map((post) => (
        <PostCard
          href={localePath(LOCALE, `/blog/${post.id}/`)}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          readingTime={readingTime(post.body)}
          image={`/og/card/${post.id}.webp`}
          locale={LOCALE}
        />
      ))
    }
  </div>

  <AdSlot slot="list" />
</BaseLayout>
