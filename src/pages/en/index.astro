---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { localePath, ui } from '../../config/i18n';
import { getSortedPosts, readingTime } from '../../utils/posts';

const LOCALE = 'en' as const;
const t = ui[LOCALE];
const posts = (await getSortedPosts(LOCALE)).slice(0, 5);
---

<BaseLayout
  title="opameti.me — open-source smart home tools"
  description="Home Assistant integrations and small open-source tools for hardware and services nobody else supports, plus notes on how they work."
  bareTitle
  lang={LOCALE}
  altHref="/"
  wide
>
  <section class="hero">
    <span class="hero__eyebrow">Home Assistant · Linux · macOS</span>
    <h1>Integrations for the devices nobody else supports</h1>
    <p>
      This is where the open-source work behind opameti.me is documented:
      Home Assistant integrations for utility and telecom providers, access
      points, appliances and 3D printers, plus a few small tools that exist
      because nothing else did the job.
    </p>
    <p>
      Everything runs locally — no vendor cloud, no account, no telemetry.
      Everything is free.
    </p>
    <p>
      <a class="btn" href="https://github.com/zonya" rel="noopener">
        Browse the projects
      </a>
      <a class="btn btn--ghost" href={localePath(LOCALE, '/blog')}>
        {t.allGuides}
      </a>
    </p>
  </section>

  {
    posts.length > 0 && (
      <section>
        <div class="section-title">
          <h2>{t.latest}</h2>
          <a href={localePath(LOCALE, '/blog')}>{t.allGuidesArrow}</a>
        </div>
        <div class="card-grid">
          {posts.map((post) => (
            <PostCard
              href={localePath(LOCALE, `/blog/${post.id}/`)}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              readingTime={readingTime(post.body)}
              image={`/og/card/${post.id}.webp`}
              locale={LOCALE}
            />
          ))}
        </div>
      </section>
    )
  }

  <section>
    <div class="section-title">
      <h2>Looking for the guides?</h2>
    </div>
    <p>
      The beginner guides — installing Home Assistant, choosing Zigbee
      hardware, writing your first automations — are written in
      <a href="/">Serbian</a>, because that is where they were missing. The
      English side of this site covers the projects instead.
    </p>
  </section>

  <AdSlot slot="list" />
</BaseLayout>
