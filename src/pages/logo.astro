---
// Radna stranica za izbor logoa — nije u navigaciji, nije u sitemapu, noindex.
// Kad se varijanta izabere, ide u BaseLayout + public/favicon.svg, a ova
// stranica se briše.
import BaseLayout from '../layouts/BaseLayout.astro';

// Boje su prepisane iz global.css da bi obe teme mogle da se prikažu na istoj
// stranici, bez obzira na to koju temu posetilac ima uključenu.
const THEMES = [
  {
    id: 'light',
    label: 'Svetla tema',
    bg: '#fbfbfd',
    surface: '#ffffff',
    text: '#16181d',
    muted: '#5f6673',
    border: '#e2e5ec',
    accent: '#1d5cf0',
    orange: '#e2670a',
  },
  {
    id: 'dark',
    label: 'Tamna tema',
    bg: '#0f1117',
    surface: '#161922',
    text: '#e7e9ee',
    muted: '#99a0ae',
    border: '#272b36',
    accent: '#79a8ff',
    orange: '#ff9a4d',
  },
];

// Znak se crta u `currentColor` (linijske varijante) ili u akcentnoj boji
// (puna), pa ista definicija radi u obe teme.
const VARIANTS = [
  {
    id: 'a',
    name: 'A — Krov i prompt, linijski',
    idea:
      'Krov = kuća, <code>&gt;_</code> = terminal. Dve stvari o kojima sajt piše, u jednom znaku. Nasleđuje boju teksta, pa radi na svakoj pozadini.',
    svg: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 13 L16 4.5 L27 13"/>
      <path d="M11 18.5 L15 22 L11 25.5"/>
      <path d="M18 25.5 L23 25.5"/>
    </svg>`,
  },
  {
    id: 'b',
    name: 'B — Isti znak, pun',
    idea:
      'Ista geometrija kao A, ali u akcentnom kvadratu. Puna površina se bolje drži na sitnim veličinama — ovo je varijanta za favicon.',
    svg: `<svg viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" rx="7" fill="var(--v-accent)"/>
      <g fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 14.5 L16 7.5 L25 14.5"/>
        <path d="M12 18.5 L15.5 21.5 L12 24.5"/>
        <path d="M18.5 24.5 L22.5 24.5"/>
      </g>
    </svg>`,
  },
  {
    id: 'c',
    name: 'C — Krov nad kursorom',
    idea:
      'Najsvedenije: krov i pun blok kursora. Ima najmanje detalja, pa je jedini koji ostaje čitljiv i na 16px. Kursor je i „mesto gde počinješ da kucaš".',
    svg: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5.5 15 L16 6 L26.5 15"/>
      <rect x="11.5" y="20" width="9" height="6" rx="1.5" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    id: 'd',
    name: 'D — Bez znaka',
    idea:
      'Samo ime. Nijedan znak ne može da pogreši poruku ako ga nema, a ime je ionako najjači deo. Favicon bi bio akcentni kvadrat sa slovom „o".',
    svg: null,
  },
];
---

<BaseLayout
  title="Izbor logoa"
  description="Radna stranica za poređenje predloga logoa."
  noindex
>
  <header class="post__header">
    <h1>Izbor logoa</h1>
    <p class="post__lead">
      Radna stranica — nije u navigaciji ni u pretrazi. Svaka varijanta je
      prikazana onako kako stvarno izgleda: u zaglavlju, pa kao favicon na
      32 i 16 piksela, u obe teme.
    </p>
  </header>

  <div class="lp">
    {
      VARIANTS.map((v) => (
        <section class="lp__variant">
          <h2>{v.name}</h2>
          <p class="lp__idea" set:html={v.idea} />

          <div class="lp__themes">
            {THEMES.map((t) => (
              <div
                class="lp__panel"
                style={`--v-bg:${t.bg};--v-surface:${t.surface};--v-text:${t.text};--v-muted:${t.muted};--v-border:${t.border};--v-accent:${t.accent};--v-orange:${t.orange}`}
              >
                <p class="lp__panel-label">{t.label}</p>

                {/* Zaglavlje u stvarnoj veličini */}
                <div class="lp__header">
                  <span class="lp__logo">
                    {v.svg && <Fragment set:html={v.svg} />}
                    <span class="lp__word">
                      opameti<span class="lp__tld">.me</span>
                    </span>
                  </span>
                  <span class="lp__nav">Vodiči · O sajtu</span>
                </div>

                {/* Iste te boje, ali sa narandžastim .me */}
                <div class="lp__header">
                  <span class="lp__logo">
                    {v.svg && <Fragment set:html={v.svg} />}
                    <span class="lp__word">
                      opameti<span class="lp__tld lp__tld--orange">.me</span>
                    </span>
                  </span>
                  <span class="lp__nav">narandžasto</span>
                </div>

                {/* Favicon veličine */}
                <div class="lp__sizes">
                  {v.svg ? (
                    <>
                      <span class="lp__size lp__size--32">
                        <Fragment set:html={v.svg} />
                      </span>
                      <span class="lp__size lp__size--16">
                        <Fragment set:html={v.svg} />
                      </span>
                    </>
                  ) : (
                    <>
                      <span class="lp__size lp__size--32">
                        <svg viewBox="0 0 32 32" aria-hidden="true">
                          <rect width="32" height="32" rx="7" fill="var(--v-accent)" />
                          <text
                            x="16"
                            y="23"
                            text-anchor="middle"
                            font-family="ui-sans-serif, system-ui, sans-serif"
                            font-size="21"
                            font-weight="700"
                            fill="#fff"
                          >
                            o
                          </text>
                        </svg>
                      </span>
                      <span class="lp__size lp__size--16">
                        <svg viewBox="0 0 32 32" aria-hidden="true">
                          <rect width="32" height="32" rx="7" fill="var(--v-accent)" />
                          <text
                            x="16"
                            y="23"
                            text-anchor="middle"
                            font-family="ui-sans-serif, system-ui, sans-serif"
                            font-size="21"
                            font-weight="700"
                            fill="#fff"
                          >
                            o
                          </text>
                        </svg>
                      </span>
                    </>
                  )}
                  <span class="lp__sizes-note">32px · 16px (favicon)</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .lp {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .lp__variant h2 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }

  .lp__idea {
    margin: 0 0 1rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .lp__themes {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 46rem) {
    .lp__themes {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lp__panel {
    background: var(--v-bg);
    border: 1px solid var(--v-border);
    border-radius: var(--radius);
    padding: 1rem 1.1rem 1.25rem;
    color: var(--v-text);
  }

  .lp__panel-label {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--v-muted);
  }

  .lp__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--v-surface);
    border: 1px solid var(--v-border);
    border-radius: 8px;
    padding: 0.7rem 0.85rem;
    margin-bottom: 0.6rem;
  }

  .lp__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
    color: var(--v-text);
  }

  /* Ista veličina kao pravi logo u zaglavlju sajta. */
  .lp__logo :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }

  .lp__tld {
    color: var(--v-accent);
  }

  .lp__tld--orange {
    color: var(--v-orange);
  }

  .lp__nav {
    font-size: 0.85rem;
    color: var(--v-muted);
  }

  .lp__sizes {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1rem;
    color: var(--v-text);
  }

  .lp__size {
    display: inline-flex;
    flex: none;
  }

  .lp__size--32 :global(svg) {
    width: 32px;
    height: 32px;
  }

  .lp__size--16 :global(svg) {
    width: 16px;
    height: 16px;
  }

  .lp__sizes-note {
    font-size: 0.8rem;
    color: var(--v-muted);
  }
</style>
